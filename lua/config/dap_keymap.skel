local dap = require('dap')

local keymap_opts = { noremap = true, silent = true }

-- Debug keymaps with arrow keys
vim.keymap.set('n', '<Down>', dap.step_over, keymap_opts)
vim.keymap.set('n', '<Right>', dap.step_into, keymap_opts)
vim.keymap.set('n', '<Left>', dap.step_out, keymap_opts)
vim.keymap.set('n', '<Up>', dap.restart_frame, keymap_opts)


dap.defaults.fallback.external_terminal = {
  command = 'alacritty',
}

-- Optional: customize signs with nerd font icons
vim.fn.sign_define('DapBreakpoint', { text = '', texthl = 'Error' })
vim.fn.sign_define('DapStopped', { text = '', texthl = 'Info' })
vim.fn.sign_define('DapBreakpointRejected', { text = '', texthl = 'Error' })



dap.listeners.before.event_stopped['dapui_config'] = function()
  vim.keymap.set('n', '<Down>', dap.step_over, { buffer = true })
  vim.keymap.set('n', '<Right>', dap.step_into, { buffer = true })
  vim.keymap.set('n', '<Left>', dap.step_out, { buffer = true })
  vim.keymap.set('n', '<Up>', dap.restart_frame, { buffer = true })
end


