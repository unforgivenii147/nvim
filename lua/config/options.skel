--vim.opt.verbosefile = "/data/data/com.termux/files/home/nvim.log"
]])
vim.api.nvim_create_autocmd("FileType", {
vim.api.nvim_create_autocmd("VimLeavePre", {
vim.api.nvim_set_hl(0, "RainbowBlue", { fg = "#61AFEF" })
