-- ~/.config/nvim/lua/plugins/lazy.lua
return {
  {
    "folke/lazy.nvim",
    opts = function(_, opts)
      opts.install = opts.install or {}
      opts.install.clone = "git clone --depth 1 --filter=blob:none {{url}} {{path}} 2>/dev/null || git clone --depth 1 {{url}} {{path}}"
      -- Optional: Also configure git settings
      opts.git = opts.git or {}
      opts.git.timeout = 60
      return opts
    end
  }
}