-- ~/.config/nvim/lua/plugins/init.lua
return {
  {
    "folke/lazy.nvim",
    opts = {
      install = {
        -- Use depth 1 for all clones
        clone = "git clone --depth 1 {{url}} {{path}}"
      },
      sync = {
        -- Clean up after sync
        run = "git gc --prune=now"
      }
    }
  }
}