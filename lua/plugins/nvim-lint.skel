-- plugins\nvim-lint.lua
return {
	{
		"mfussenegger/nvim-lint",
		event = { "BufReadPre", "BufNewFile" }, -- load automatically for files
		config = function()
			local lint = require("lint")

			-- Associate markdownlint with Markdown files
			lint.linters_by_ft = {
				markdown = { "markdownlint" },
			}

			-- Auto-lint on save
			vim.api.nvim_create_autocmd({ "BufWritePost" }, {
				callback = function()
					require("lint").try_lint()
				end,
			})

			-- Optional manual lint command
			vim.api.nvim_create_user_command("Lint", function()
				require("lint").try_lint()
			end, { desc = "Run linter" })
		end,
	},
}
