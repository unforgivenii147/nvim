vim.opt.undofile = true
vim.opt.updatetime = 250
vim.opt.wrap = false

vim.opt.guicursor = {
  "n-v-c:block,i:ver25,ve:ver35,o:hor50",
  "a:blinkwait700-blinkoff400-blinkon250-Cursor/lCursor",
  "sm:block-blinkwait500-blinkoff400-blinkon250",
}


-- Force cursor reset on exit (Termux-specific)
vim.api.nvim_create_autocmd("VimLeavePre", {
  callback = function()
    -- Reset cursor to original (underline/vertical line, depending on your term)
    -- \x1b[5 q = underline (normal in Termux)
    -- \x1b[3 q = vertical bar
    -- \x1b[0 q = default (usually block)
    vim.fn.system("printf '\x1b[5 q'")
  end,
})

local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not vim.loop.fs_stat(lazypath) then
  vim.fn.system({
    "git",
    "clone",
    "--filter=blob:none",
    "https://github.com/folke/lazy.nvim.git",
    "--branch=stable",
    lazypath,
  })
end
vim.opt.rtp:prepend(lazypath)

